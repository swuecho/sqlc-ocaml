opam-version: "2.0"
synopsis: "Caqti Lwt pool helpers for sqlc-generated OCaml code"
maintainer: "sqlc-ocaml maintainers"
authors: "sqlc-ocaml contributors"
homepage: "https://github.com/swuecho/sqlc-ocaml"
bug-reports: "https://github.com/swuecho/sqlc-ocaml/issues"
dev-repo: "git+https://github.com/swuecho/sqlc-ocaml.git"
build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml"
  "dune" {>= "3.12"}
  "caqti-lwt"
  "uri"
]
